{
  "name": "php-baremetal-examples/event-driven-hello",
  "type": "project",
  "license": "proprietary",
  "description": "The reactor with a timer every() source.",
  "repositories": [
    {
      "type": "composer",
      "url": "https://repository.php-baremetal.com",
      "canonical": true
    }
  ],
  "require": {
    "php-baremetal/conductor": "^1.0",
    "php-baremetal/ext-events": "^1.0"
  },
  "config": {
    "allow-plugins": {
      "php-baremetal/conductor": true
    },
    "platform": {
      "php": "8.5.11"
    }
  },
  "extra": {
    "baremetal": {
      "sdk": "esp32@^2.0",
      "board": "waveshare-esp32-s3-zero-n8r8",
      "runtime": "event-driven",
      "storage": "embedded",
      "options": {
        "power-save": "off"
      }
    }
  }
}
