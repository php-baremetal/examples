{
  "name": "php-baremetal-examples/ext-selftest",
  "type": "project",
  "license": "proprietary",
  "description": "Self-checks every subsystem: WiFi, LED, GPIO, in-RAM mem, persistent store, sys info.",
  "repositories": [
    {
      "type": "composer",
      "url": "https://repository.php-baremetal.com",
      "canonical": true
    }
  ],
  "require": {
    "php-baremetal/conductor": "^1.0",
    "php-baremetal/ext-gpio": "^1.0",
    "php-baremetal/ext-led": "^1.0",
    "php-baremetal/ext-mem": "^1.0",
    "php-baremetal/ext-store": "^1.0",
    "php-baremetal/ext-sys": "^1.0",
    "php-baremetal/ext-wifi": "^1.0",
    "php-baremetal/led-ws2812": "^1.0"
  },
  "config": {
    "allow-plugins": {
      "php-baremetal/conductor": true
    },
    "platform": {
      "php": "8.5.11"
    }
  },
  "extra": {
    "baremetal": {
      "sdk": "esp32@^2.0",
      "board": "waveshare-esp32-s3-zero-n8r8",
      "runtime": "init-loop",
      "storage": "embedded",
      "options": {
        "restart-delay": 3600
      }
    }
  }
}
