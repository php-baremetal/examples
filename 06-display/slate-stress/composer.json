{
  "name": "php-baremetal-examples/slate-stress",
  "type": "project",
  "license": "proprietary",
  "description": "A busy Slate scene: a dozen translucent dots, a sliding card with a shadow, a pulsing translucent group, a progress ring and a frame counter, all moved at 60 Hz, with the IMU polled at 100 Hz, a touch-following circle and Wi-Fi connecting in the background; the slate-debug profiler shows what it costs.",
  "repositories": [
    {
      "type": "composer",
      "url": "https://repository.php-baremetal.com",
      "canonical": true
    }
  ],
  "require": {
    "php-baremetal/conductor": "^1.0",
    "php-baremetal/ext-spi": "^1.0",
    "php-baremetal/esp32-display-st77916": "^1.2",
    "php-baremetal/ext-display": "^1.1",
    "php-baremetal/ext-events": "^1.2",
    "php-baremetal/ext-i2c": "^1.1.1",
    "php-baremetal/ext-input": "^1.0",
    "php-baremetal/touch-cst816s": "^1.0",
    "php-baremetal/ext-slate": "^1.0",
    "php-baremetal/imu-qmi8658": "^1.0",
    "php-baremetal/ext-wifi": "^1.1"
  },
  "config": {
    "allow-plugins": {
      "php-baremetal/conductor": true
    },
    "platform": {
      "php": "8.5.11"
    }
  },
  "extra": {
    "baremetal": {
      "sdk": "esp32@^2.0",
      "board": "waveshare-esp32-s3-touch-lcd-1.85b",
      "runtime": "event-driven",
      "storage": "embedded",
      "options": {
        "slate-debug": true
      },
      "env": ".env"
    }
  }
}
