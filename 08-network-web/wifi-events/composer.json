{
  "name": "php-baremetal-examples/wifi-events",
  "type": "project",
  "license": "proprietary",
  "description": "Follow the Wi-Fi station with events: scan, connect, drops and retries, without blocking.",
  "repositories": [
    {
      "type": "composer",
      "url": "https://repository.php-baremetal.com",
      "canonical": true
    }
  ],
  "require": {
    "php-baremetal/conductor": "^1.0",
    "php-baremetal/ext-events": "^1.1",
    "php-baremetal/ext-sys": "^1.0",
    "php-baremetal/ext-wifi": "^1.1"
  },
  "config": {
    "allow-plugins": {
      "php-baremetal/conductor": true
    },
    "platform": {
      "php": "8.5.11"
    }
  },
  "extra": {
    "baremetal": {
      "sdk": "esp32@^2.0",
      "board": "waveshare-esp32-s3-zero-n8r8",
      "runtime": "event-driven",
      "storage": "embedded",
      "env": ".env"
    }
  }
}
