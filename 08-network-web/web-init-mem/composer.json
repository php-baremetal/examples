{
  "name": "php-baremetal-examples/web-init-mem",
  "type": "project",
  "license": "proprietary",
  "description": "Per-request handlers share in-RAM state via ext-mem; one-time init.php.",
  "repositories": [
    {
      "type": "composer",
      "url": "https://repository.php-baremetal.com",
      "canonical": true
    }
  ],
  "require": {
    "php-baremetal/conductor": "^1.0",
    "php-baremetal/ext-mem": "^1.0"
  },
  "config": {
    "allow-plugins": {
      "php-baremetal/conductor": true
    },
    "platform": {
      "php": "8.5.11"
    }
  },
  "extra": {
    "baremetal": {
      "sdk": "esp32@^2.0",
      "board": "waveshare-esp32-p4-eth",
      "runtime": "web-server",
      "storage": "embedded",
      "options": {
        "init": "init.php"
      }
    }
  }
}
