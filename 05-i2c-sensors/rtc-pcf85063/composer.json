{
  "name": "php-baremetal-examples/rtc-pcf85063",
  "type": "project",
  "license": "proprietary",
  "description": "Set and read the PCF85063 RTC over I2C (rtc-pcf85063 driver).",
  "repositories": [
    {
      "type": "composer",
      "url": "https://repository.php-baremetal.com",
      "canonical": true
    }
  ],
  "require": {
    "php-baremetal/conductor": "^1.0",
    "php-baremetal/ext-i2c": "^1.0",
    "php-baremetal/rtc-pcf85063": "^1.0"
  },
  "config": {
    "allow-plugins": {
      "php-baremetal/conductor": true
    },
    "platform": {
      "php": "8.5.11"
    }
  },
  "extra": {
    "baremetal": {
      "sdk": "esp32@^2.0",
      "board": "waveshare-esp32-s3-touch-lcd-1.85b",
      "runtime": "init-loop",
      "storage": "embedded"
    }
  }
}
