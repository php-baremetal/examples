{
  "name": "php-baremetal-examples/symfony-demo",
  "type": "project",
  "license": "proprietary",
  "description": "Symfony demo application, browsable over HTTP (web-server runtime) on a Waveshare ESP32-P4 Ethernet board.",
  "repositories": [
    {
      "type": "composer",
      "url": "https://repository.php-baremetal.com",
      "canonical": true
    }
  ],
  "require": {
    "php-baremetal/conductor": "^1.0",
    "php-baremetal/php-ctype": "^1.0",
    "php-baremetal/php-date": "^1.0",
    "php-baremetal/php-filter": "^1.0",
    "php-baremetal/php-mbstring": "^1.0",
    "php-baremetal/php-opcache": "^1.0",
    "php-baremetal/php-session": "^1.0",
    "php-baremetal/php-tokenizer": "^1.0"
  },
  "config": {
    "allow-plugins": {
      "php-baremetal/conductor": true
    },
    "platform": {
      "php": "8.5.11"
    }
  },
  "extra": {
    "baremetal": {
      "sdk": "esp32@^2.0",
      "board": "waveshare-esp32-p4-eth",
      "runtime": "web-server",
      "storage": "microsd",
      "entry": "public/index.php",
      "options": {
        "request-timeout": 120
      }
    }
  }
}
