{
  "name": "php-baremetal-examples/power-save",
  "type": "project",
  "license": "proprietary",
  "description": "Automatic light sleep (power-save option) with power_hold()/power_release().",
  "repositories": [
    {
      "type": "composer",
      "url": "https://repository.php-baremetal.com",
      "canonical": true
    }
  ],
  "require": {
    "php-baremetal/conductor": "^1.0",
    "php-baremetal/ext-events": "^1.0"
  },
  "config": {
    "allow-plugins": {
      "php-baremetal/conductor": true
    },
    "platform": {
      "php": "8.5.11"
    }
  },
  "extra": {
    "baremetal": {
      "sdk": "esp32@^2.0",
      "board": "waveshare-esp32-s3-zero",
      "runtime": "event-driven",
      "storage": "embedded",
      "options": {
        "power-save": "on"
      }
    }
  }
}
